{
  "name": "concursaia-backnode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && npm run build:worker",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts tools/importacao/scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts tools/importacao/scripts package.json tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test tests/postgres/*.test.ts",
    "test:importacao": "node --test tools/importacao/scripts/importacao-prova.test.mjs",
    "check:parity": "tsx scripts/verificar-integridade-e-paridade-origem.ts",
    "test:parity": "python3 scripts/preparar-copia-referencia-dotnet.py && dotnet build .tmp/dotnet-reference/ConcursaAI.Api/ConcursaAI.Api.csproj --nologo -m:1 -v quiet && tsx --test tests/parity/*.test.ts",
    "check:database": "tsx scripts/verificar-conexao-supabase.ts",
    "test:all": "npm run format:check && npm run build && npm test && npm run test:postgres && npm run test:importacao && npm run check:parity",
    "import:prova": "node tools/importacao/scripts/importar-prova.mjs",
    "check:integration": "tsx scripts/verificar-integracao-supabase.ts",
    "build:worker": "tsc -p tsconfig.worker.json",
    "worker:email": "node dist-worker/worker-emails-supabase.js",
    "check:worker": "node dist-worker/worker-emails-supabase.js --verificar"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swagger-ui-dist": "5.34.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "embedded-postgres": "17.10.0-beta.17",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
