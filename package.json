{
  "name": "concursaia-backnode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test tests/postgres/*.test.ts",
    "test:importacao": "node --test tools/importacao/scripts/importar-prova.test.mjs",
    "check:parity": "tsx scripts/check-parity.ts",
    "test:parity": "python3 scripts/prepare-dotnet-reference.py && dotnet build .tmp/dotnet-reference/ConcursaAI.Api/ConcursaAI.Api.csproj --nologo -m:1 -v quiet && tsx --test tests/parity/*.test.ts",
    "check:database": "tsx scripts/check-database.ts",
    "test:all": "npm run build && npm test && npm run test:postgres && npm run test:importacao && npm run check:parity",
    "import:prova": "node tools/importacao/scripts/importar-prova.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
