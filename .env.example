NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
# Lista separada por vírgulas; vazio aceita clientes diretos sem habilitar CORS.
CORS_ORIGINS=
# Usuário restrito; nunca postgres/service_role. Fora de loopback exige verify-full.
DATABASE_URL=postgresql://concursa_backend:CHANGE_ME@DB_HOST:5432/postgres?sslmode=verify-full
DATABASE_CA_FILE=certificates/supabase-prod-ca-2021.crt
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT_MS=15000
DATABASE_COMMAND_TIMEOUT_MS=60000
# Base64 de no mínimo 64 bytes; reutilize a chave original para preservar JWTs/links.
AUTH_SIGNING_KEY=
AUTH_ISSUER=ConcursaAI
AUTH_AUDIENCE=ConcursaAI
AUTH_ACCESS_MINUTES=15
AUTH_SESSION_DAYS=7
# Origem autorizada para links de e-mail/retorno OAuth. Não exige frontend em execução.
AUTH_CLIENT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
VIACEP_URL=https://viacep.com.br/ws/
EMAIL_APP_NAME=ConcursaAI
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME=ConcursaAI
RESEND_WEBHOOK_SECRET=
RESEND_URL=https://api.resend.com/
EMAIL_WORKER_ENABLED=true
EMAIL_INTERVAL_SECONDS=15
EMAIL_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=5
EMAIL_RESERVATION_SECONDS=120
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_RETENTION_DAYS=90
EMAIL_INACTIVITY_DAYS=7,15,30
EMAIL_VERIFICATION_ENABLED=true
EMAIL_WELCOME_ENABLED=true
EMAIL_PASSWORD_RESET_ENABLED=true
EMAIL_INACTIVE_ENABLED=false

# Utilitário opcional de importação administrativa.
CONCURSA_API_URL=http://127.0.0.1:3000
CONCURSA_IMPORT_TOKEN=
