NODE_ENV=development
# Next.js API: acesso ao Supabase apenas no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
# Lista separada por vírgulas; vazio aceita clientes diretos sem habilitar CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Apenas para links legados cifrados na fila; a sessão da API usa Supabase Auth.
# Base64 de no mínimo 64 bytes, preservando a chave original desses links.
AUTH_SIGNING_KEY=
# Origem autorizada para links de e-mail/retorno OAuth. Não exige frontend em execução.
AUTH_CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# Informe os preços do modelo contratado em USD por 1 milhão de tokens para estimar custos.
OPENAI_PRECO_ENTRADA_MILHAO_USD=
OPENAI_PRECO_SAIDA_MILHAO_USD=
VIACEP_URL=https://viacep.com.br/ws/
EMAIL_APP_NAME=ConcursaAI
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME=ConcursaAI
RESEND_WEBHOOK_SECRET=
RESEND_URL=https://api.resend.com/
EMAIL_WORKER_ENABLED=true
EMAIL_INTERVAL_SECONDS=15
EMAIL_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=5
EMAIL_RESERVATION_SECONDS=120
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_RETENTION_DAYS=90
EMAIL_INACTIVITY_DAYS=7,15,30
EMAIL_VERIFICATION_ENABLED=true
EMAIL_WELCOME_ENABLED=true
EMAIL_PASSWORD_RESET_ENABLED=true
EMAIL_INACTIVE_ENABLED=false

# Utilitário opcional de importação administrativa.
CONCURSA_API_URL=http://127.0.0.1:3000
CONCURSA_IMPORT_TOKEN=

# Mercado Pago — somente servidor. Comece pelas credenciais de TESTE.
MP_AMBIENTE=teste
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SELLER_ID=
MP_APPLICATION_ID=
# HTTPS público do frontend, sem query string. O backend acrescenta o pedido.
MP_RETORNO_URL=https://app.seu-dominio.com/pagamento/retorno
# Habilitar parcelas não garante disponibilidade nem isenção de juros.
MP_MAX_PARCELAS=1
MP_TIMEOUT_MS=7000
MP_WORKER_SECRET=
MP_PRODUCAO_HABILITADA=false
MP_OPERACOES_FINANCEIRAS_HABILITADAS=false
MP_OPERACOES_PRODUCAO_AUTORIZADAS=false
EMAIL_SUBSCRIPTION_EXPIRING_ENABLED=true
