# No Render, configure as variáveis privadas no ambiente do Web Service.
# Origem autorizada no navegador e usada nos links de e-mail e OAuth.
# Pode ficar vazia se a API for usada apenas por clientes sem navegador.
FRONTEND_APPLICATION_URL=http://localhost:5173
# BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.seu-dominio.com
# BACKEND_TRUSTED_PROXY_HOP_COUNT=1

# URL raiz do projeto Supabase e chaves usadas pelo servidor.
SUPABASE_PROJECT_URL=
SUPABASE_PUBLISHABLE_API_KEY=
# Chave privada do projeto (sb_secret_ ou service_role legada).
SUPABASE_SERVER_SECRET_API_KEY=

# OpenAI para análise de questões.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4.1-mini

# Mercado Pago. Configure o webhook em /api/financeiro/webhook na URL da API.
# Use credenciais do ambiente selecionado.
MERCADO_PAGO_ENVIRONMENT=teste
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SIGNING_SECRET=
MERCADO_PAGO_SELLER_ACCOUNT_ID=
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_CHECKOUT_RETURN_URL=
MERCADO_PAGO_PRODUCTION_ENABLED=false
# MERCADO_PAGO_MAINTENANCE_AUTHORIZATION_SECRET=

# Resend para o worker de e-mails transacionais.
RESEND_API_KEY=
RESEND_SENDER_EMAIL_ADDRESS=
RESEND_SENDER_DISPLAY_NAME=ConcursaAI
RESEND_WEBHOOK_SIGNING_SECRET=
TRANSACTIONAL_EMAIL_WORKER_ENABLED=false

# Consulte docs/CONFIGURACAO.md para valores padrão e ajustes adicionais.
